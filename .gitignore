# ── 依赖 ──────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*

# ── 构建产物 ───────────────────────────────────────────────
dist/
build/
out/
.next/
bundle/

# 前端静态构建输出
apps/web/dist/
apps/admin/dist/

# ── 环境变量（敏感信息，绝对不能提交）─────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
apps/api/.env.production
apps/api/.env.staging
apps/mcp/.env.production
apps/mcp/.env.staging

# 保留示例文件
!.env.example
!**/.env.example

# ── 数据库 ─────────────────────────────────────────────────
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 保留 dev.db 的目录结构但忽略文件本身
packages/database/prisma/dev.db
packages/database/prisma/prod.db

# Prisma 迁移锁（可选：如果团队协作建议保留）
# packages/database/prisma/migrations/

# ── 日志 ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDE / 编辑器 ───────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ── 操作系统 ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── TypeScript ─────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── 测试覆盖率 ─────────────────────────────────────────────
coverage/
.nyc_output/

# ── Markdown 文档 ──────────────────────────────────────────
*.md
!README.md

# ── 临时文件 ───────────────────────────────────────────────
tmp/
temp/
*.tmp
*.temp
*.bak

# ── PM2 ────────────────────────────────────────────────────
.pm2/

# ── 证书 ───────────────────────────────────────────────────
