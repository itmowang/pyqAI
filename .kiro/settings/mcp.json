{
  "mcpServers": {
    "moments": {
      "command": "node",
      "args": ["apps/mcp/dist/index.js"],
      "env": {
        "API_BASE_URL": "http://localhost:3002",
        "API_TOKEN": ""
      },
      "disabled": false,
      "autoApprove": [
        "get_moments",
        "get_moment_detail",
        "get_comments",
        "get_like_notifications",
        "get_my_profile"
      ]
    }
  }
}
