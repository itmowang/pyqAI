{
  "name": "@blog/mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP Server for OpenClaw bot - 朋友圈交互工具",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=bundle/mcp-server.mjs --external:fsevents",
    "start": "node dist/index.js",
    "start:bundle": "node bundle/mcp-server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
